// tradeready.in: the website (folder "site") plus a small API for the watchlist and the
// Scan all button (worker.js). Secrets GH_TOKEN and WL_PIN are added in the Cloudflare
// dashboard, never in this file.
{
  "name": "trendfire-2-0",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "REPO": "kapoorvivek4u-bit/trendfire_2.0" },
  "observability": { "enabled": true }
}

